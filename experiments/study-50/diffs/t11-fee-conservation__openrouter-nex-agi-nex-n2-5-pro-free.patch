@@ -1,10 +1,12 @@
 use mini_app::ledger::Ledger;
 use mini_app::settlement::Settlement;
+use mini_app::FEES_ACCOUNT;
 
 fn accounts() -> Ledger {
     let mut l = Ledger::new();
     l.open("alice", 100).unwrap();
     l.open("bob", 0).unwrap();
+    l.open(FEES_ACCOUNT, 0).unwrap();
     l
 }
 
@@ -29,3 +31,33 @@ fn hold_is_refused_without_funds() {
     assert!(s.hold(&mut l, "alice", "bob", 300).is_err());
     assert_eq!(l.balance("alice"), 100);
 }
+
+#[test]
+fn fee_is_exact() {
+    let mut l = accounts();
+    let mut s = Settlement::new();
+    let id = s.hold(&mut l, "alice", "bob", 100).unwrap();
+    let total_before = l.total();
+
+    let fee = s.settle_with_fee(&mut l, id, 333).unwrap();
+
+    assert_eq!(fee, 3);
+    assert_eq!(l.balance("alice"), 0);
+    assert_eq!(l.balance("bob"), 97);
+    assert_eq!(l.balance(FEES_ACCOUNT), 3);
+    assert_eq!(l.total(), total_before);
+}
+
+#[test]
+fn settling_a_hold_twice_does_not_charge_the_fee_twice() {
+    let mut l = accounts();
+    let mut s = Settlement::new();
+    let id = s.hold(&mut l, "alice", "bob", 100).unwrap();
+
+    assert_eq!(s.settle_with_fee(&mut l, id, 1_000).unwrap(), 10);
+    assert!(s.settle_with_fee(&mut l, id, 1_000).is_err());
+
+    assert_eq!(l.balance("bob"), 90);
+    assert_eq!(l.balance(FEES_ACCOUNT), 10);
+    assert_eq!(l.total(), 100);
+}
