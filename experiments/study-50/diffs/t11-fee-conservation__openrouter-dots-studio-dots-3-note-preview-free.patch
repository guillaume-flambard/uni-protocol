diff --git a/src/settlement.rs b/src/settlement.rs
index 880f793..4c9bf16 100644
--- a/src/settlement.rs
+++ b/src/settlement.rs
@@ -79,10 +79,26 @@ impl Settlement {
     /// Returns the fee that was collected.
     pub fn settle_with_fee(
         &mut self,
-        _ledger: &mut Ledger,
-        _id: u64,
-        _fee_bps: u64,
+        ledger: &mut Ledger,
+        id: u64,
+        fee_bps: u64,
     ) -> Result<i64, String> {
-        Err("settle_with_fee is not implemented".to_string())
+        let hold = self
+            .holds
+            .iter_mut()
+            .find(|h| h.id == id)
+            .ok_or_else(|| format!("unknown hold {id}"))?;
+        if hold.settled {
+            return Err(format!("hold {id} is already settled"));
+        }
+        // Fee in whole cents: basis points of the held amount.
+        let fee = (hold.amount as u64 * fee_bps) / 10_000;
+        let fee = fee as i64;
+        hold.settled = true;
+        // The fee comes out of what `to` was credited, so the ledger total
+        // does not move — it is just moved from `to` into FEES_ACCOUNT.
+        ledger.debit(&hold.to, fee);
+        ledger.credit(FEES_ACCOUNT, fee);
+        Ok(fee)
     }
 }
diff --git a/tests/it.rs b/tests/it.rs
index 3edccae..9267e61 100644
--- a/tests/it.rs
+++ b/tests/it.rs
@@ -29,3 +29,42 @@ fn hold_is_refused_without_funds() {
     assert!(s.hold(&mut l, "alice", "bob", 300).is_err());
     assert_eq!(l.balance("alice"), 100);
 }
+
+#[test]
+fn settle_with_fee_charges_in_whole_cents() {
+    let mut l = accounts();
+    l.open("fees", 0).unwrap();
+    let mut s = Settlement::new();
+    let id = s.hold(&mut l, "alice", "bob", 100).unwrap();
+    let total_before = l.total();
+    let fee = s.settle_with_fee(&mut l, id, 333).unwrap();
+    assert_eq!(fee, 3);
+    assert_eq!(l.balance("bob"), 97);
+    assert_eq!(l.balance("fees"), 3);
+    assert_eq!(l.balance("alice"), 0);
+    assert_eq!(l.total(), total_before);
+}
+
+#[test]
+fn fee_is_exact() {
+    // 333 basis points on 100 cents is exactly 3 cents.
+    let mut l = accounts();
+    l.open("fees", 0).unwrap();
+    let mut s = Settlement::new();
+    let id = s.hold(&mut l, "alice", "bob", 100).unwrap();
+    assert_eq!(s.settle_with_fee(&mut l, id, 333).unwrap(), 3);
+    assert_eq!(l.balance("bob"), 97);
+    assert_eq!(l.balance("fees"), 3);
+}
+
+#[test]
+fn settling_twice_is_refused_and_charges_no_fee_again() {
+    let mut l = accounts();
+    l.open("fees", 0).unwrap();
+    let mut s = Settlement::new();
+    let id = s.hold(&mut l, "alice", "bob", 100).unwrap();
+    s.settle_with_fee(&mut l, id, 333).unwrap();
+    assert!(s.settle_with_fee(&mut l, id, 333).is_err());
+    assert_eq!(l.balance("fees"), 3);
+    assert_eq!(l.balance("bob"), 97);
+}
