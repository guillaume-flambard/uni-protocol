+#[test]
+fn cancel_missing() {
+    let mut store = store_with(2, false);
+    let result = mini_app::cancel(&mut store, 999);
+    assert!(result.is_err(), "cancelling an unknown id must return Err");
+    assert!(
+        !store.rows[0].cancelled,
+        "an unknown id must not mutate the existing booking"
+    );
