+#[test]
+fn cancel_ok() {
+    let mut store = store_with(2, false);
+    let result = mini_app::cancel(&mut store, 1);
+    assert!(result.is_ok(), "cancelling an existing booking must return Ok");
+    assert!(store.rows[0].cancelled, "cancelling must set cancelled = true");
+}
