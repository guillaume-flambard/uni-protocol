-use crate::store::Store;
+use crate::repo::{self, Store};
 
 /// Cancel a booking by id.
 ///
-/// BUG 1 (behaviour): returns Ok even when the booking does not exist.
-/// BUG 2 (architecture): reaches into the storage module directly instead of
-/// going through `crate::repo`, which is the only layer allowed to touch it.
+/// Returns `Ok(())` and marks the booking cancelled when `id` exists, or
+/// `Err(...)` when the booking is unknown. Storage is reached only through
+/// `crate::repo`, the single layer allowed to touch the store internals.
 pub fn cancel(store: &mut Store, id: u32) -> Result<(), String> {
-    for row in store.rows.iter_mut() {
-        if row.id == id {
-            row.cancelled = true;
+    match repo::get_mut(store, id) {
+        Some(booking) => {
+            booking.cancelled = true;
+            Ok(())
         }
+        None => Err(format!("booking {id} not found")),
     }
-    Ok(())
 }
