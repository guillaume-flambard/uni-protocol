diff --git a/tests/it.rs b/tests/it.rs
index 08ded73..07da9b8 100644
--- a/tests/it.rs
+++ b/tests/it.rs
@@ -16,3 +16,19 @@ fn store_holds_rows() {
     let store = store_with(2, false);
     assert_eq!(store.rows.len(), 1);
 }
+
+#[test]
+fn cancel_ok() {
+    let mut store = store_with(2, false);
+    assert!(!store.rows[0].cancelled);
+    let result = mini_app::service::cancel(&mut store, 1);
+    assert!(result.is_ok());
+    assert!(store.rows[0].cancelled);
+}
+
+#[test]
+fn cancel_missing() {
+    let mut store = store_with(2, false);
+    let result = mini_app::service::cancel(&mut store, 999);
+    assert!(result.is_err());
+}
