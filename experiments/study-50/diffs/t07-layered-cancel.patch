diff --git a/src/repo.rs b/src/repo.rs
index e750b83..b77f99c 100644
--- a/src/repo.rs
+++ b/src/repo.rs
@@ -8,3 +8,13 @@ pub fn get(store: &Store, id: u32) -> Option<&crate::domain::Booking> {
 pub fn get_mut(store: &mut Store, id: u32) -> Option<&mut crate::domain::Booking> {
     store.rows.iter_mut().find(|b| b.id == id)
 }
+
+pub fn cancel(store: &mut Store, id: u32) -> Result<(), String> {
+    match get_mut(store, id) {
+        Some(booking) => {
+            booking.cancelled = true;
+            Ok(())
+        }
+        None => Err("Booking not found".to_string()),
+    }
+}
