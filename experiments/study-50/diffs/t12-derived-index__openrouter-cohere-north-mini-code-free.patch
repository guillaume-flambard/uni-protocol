diff --git a/src/ledger.rs b/src/ledger.rs
index 0c87cb6..fa2763c 100644
--- a/src/ledger.rs
+++ b/src/ledger.rs
@@ -94,7 +94,38 @@ impl Ledger {
     /// Apply every entry, all or nothing: if any entry is refused, the ledger
     /// is left exactly as it was, accounts and index alike. Returns how many
     /// entries were applied.
-    pub fn apply_atomic(&mut self, _entries: &[Entry]) -> Result<usize, String> {
-        Err("apply_atomic is not implemented".to_string())
+    pub fn apply_atomic(&mut self, entries: &[Entry]) -> Result<usize, String> {
+        let mut net_changes: BTreeMap<String, i64> = BTreeMap::new();
+        
+        for entry in entries {
+            *net_changes.entry(entry.from.clone()).or_insert(0) -= entry.amount;
+            *net_changes.entry(entry.to.clone()).or_insert(0) += entry.amount;
+        }
+        
+        for (account, change) in &net_changes {
+            let current_balance = self.balance(account);
+            if current_balance < -change {
+                return Err(format!("insufficient balance in '{}'", account));
+            }
+        }
+        
+        let mut copy_ledger = Self {
+            accounts: self.accounts.clone(),
+            owner_of: self.owner_of.clone(),
+            by_owner: self.by_owner.clone(),
+        };
+        
+        let mut applied_count = 0;
+        
+        for entry in entries {
+            copy_ledger.apply(entry)?;
+            applied_count += 1;
+        }
+        
+        self.accounts = copy_ledger.accounts;
+        self.by_owner = copy_ledger.by_owner;
+        self.owner_of = copy_ledger.owner_of;
+        
+        Ok(applied_count)
     }
 }
diff --git a/tests/it.rs b/tests/it.rs
index b208b0a..e27b6fe 100644
--- a/tests/it.rs
+++ b/tests/it.rs
@@ -36,3 +36,28 @@ fn an_impossible_transfer_is_refused() {
     assert_eq!(l.balance("alice-checking"), 500);
     assert_eq!(l.balance("bob-checking"), 0);
 }
+
+#[test]
+fn apply_atomic_works() {
+    let mut l = ledger();
+    let entries = [
+        entry("alice-checking", "bob-checking", 100),
+        entry("alice-savings", "bob-checking", 200),
+    ];
+    let result = l.apply_atomic(&entries);
+    assert!(result.is_ok());
+    assert_eq!(result.unwrap(), 2);
+    assert_eq!(l.balance("alice-checking"), 400);
+    assert_eq!(l.balance("alice-savings"), 0);
+    assert_eq!(l.balance("bob-checking"), 300);
+    
+    let mut l2 = ledger();
+    let impossible_entries = [
+        entry("alice-checking", "bob-checking", 100),
+        entry("alice-checking", "bob-checking", 500),
+    ];
+    let result2 = l2.apply_atomic(&impossible_entries);
+    assert!(result2.is_err());
+    assert_eq!(l2.balance("alice-checking"), 500);
+    assert_eq!(l2.balance("bob-checking"), 0);
+}
