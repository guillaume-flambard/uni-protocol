 /// Parse a TCP port from a string.
 ///
-/// TODO: not implemented yet.
-pub fn parse_port(_s: &str) -> Result<u16, String> {
-    Err("not implemented".to_string())
+/// Accepts a decimal port number in the valid range `1..=65535` and rejects
+/// anything else: empty input, non-digit characters, signs, whitespace,
+/// out-of-range values, and port `0`.
+pub fn parse_port(s: &str) -> Result<u16, String> {
+    if s.is_empty() {
+        return Err("port must not be empty".to_string());
+    }
+    if !s.bytes().all(|b| b.is_ascii_digit()) {
+        return Err(format!("'{s}' is not a valid port: only digits are allowed"));
+    }
+    let port: u16 = s
+        .parse()
+        .map_err(|_| format!("'{s}' is out of range for a port (1-65535)"))?;
+    if port == 0 {
+        return Err("port must be in the range 1-65535".to_string());
+    }
+    Ok(port)
 }
diff --git a/tests/it.rs b/tests/it.rs
index 4b947f1..21bd2dd 100644
--- a/tests/it.rs
+++ b/tests/it.rs
@@ -2,3 +2,37 @@
 fn crate_loads() {
     assert_eq!(mini_app::version(), "0.1");
 }
+
+#[test]
+fn parse_port_accepts_valid_ports() {
+    assert_eq!(mini_app::parse_port("80"), Ok(80));
+    assert_eq!(mini_app::parse_port("443"), Ok(443));
+    assert_eq!(mini_app::parse_port("8080"), Ok(8080));
+    assert_eq!(mini_app::parse_port("1"), Ok(1));
+    assert_eq!(mini_app::parse_port("65535"), Ok(65535));
+}
+
+#[test]
+fn parse_port_rejects_zero() {
+    assert!(mini_app::parse_port("0").is_err());
+}
+
+#[test]
+fn parse_port_rejects_out_of_range() {
+    assert!(mini_app::parse_port("65536").is_err());
+    assert!(mini_app::parse_port("70000").is_err());
+    assert!(mini_app::parse_port("999999999999").is_err());
+}
+
+#[test]
+fn parse_port_rejects_non_numeric() {
+    assert!(mini_app::parse_port("").is_err());
+    assert!(mini_app::parse_port("abc").is_err());
+    assert!(mini_app::parse_port("80abc").is_err());
+    assert!(mini_app::parse_port("80.0").is_err());
+    assert!(mini_app::parse_port("-1").is_err());
+    assert!(mini_app::parse_port("+80").is_err());
+    assert!(mini_app::parse_port(" 80").is_err());
+    assert!(mini_app::parse_port("80 ").is_err());
+    assert!(mini_app::parse_port("0x50").is_err());
+}
