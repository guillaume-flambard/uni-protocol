 /// Parse a TCP port from a string.
 ///
-/// TODO: not implemented yet.
-pub fn parse_port(_s: &str) -> Result<u16, String> {
-    Err("not implemented".to_string())
+/// Returns Ok(port) if the input is a valid port number (0-65535), otherwise returns Err with an appropriate error message.
+pub fn parse_port(s: &str) -> Result<u16, String> {
+    s.parse::<u16>().map_err(|_| {
+        if s.is_empty() {
+            "empty port".to_string()
+        } else if let Ok(num) = s.parse::<u32>() {
+            "port out of range (0-65535)".to_string()
+        } else {
+            "port is not a number".to_string()
+        }
+    })
 }
diff --git a/tests/it.rs b/tests/it.rs
