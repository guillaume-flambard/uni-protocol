 fn crate_loads() {
     assert_eq!(mini_app::version(), "0.1");
 }
+
+#[test]
+fn parse_valid() {
+    let result = mini_app::parse_port("8080");
+    assert_eq!(result, Ok(8080));
+}
+
+#[test]
+fn parse_invalid() {
+    let result1 = mini_app::parse_port("not-a-number");
+    assert!(result1.is_err());
+    
+    let result2 = mini_app::parse_port("70000");
+    assert!(result2.is_err());
+    
+    let result3 = mini_app::parse_port("");
+    assert!(result3.is_err());
+}
