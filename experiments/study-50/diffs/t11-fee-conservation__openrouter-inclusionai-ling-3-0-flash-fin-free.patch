diff --git a/src/settlement.rs b/src/settlement.rs
index 880f793..99f027b 100644
--- a/src/settlement.rs
+++ b/src/settlement.rs
@@ -79,10 +79,22 @@ impl Settlement {
     /// Returns the fee that was collected.
     pub fn settle_with_fee(
         &mut self,
-        _ledger: &mut Ledger,
-        _id: u64,
-        _fee_bps: u64,
+        ledger: &mut Ledger,
+        id: u64,
+        fee_bps: u64,
     ) -> Result<i64, String> {
-        Err("settle_with_fee is not implemented".to_string())
+        let hold = self
+            .holds
+            .iter_mut()
+            .find(|h| h.id == id)
+            .ok_or_else(|| format!("unknown hold {id}"))?;
+        if hold.settled {
+            return Err(format!("hold {id} is already settled"));
+        }
+        let fee = hold.amount * fee_bps as i64 / 10000;
+        ledger.debit(&hold.to, fee);
+        ledger.credit(FEES_ACCOUNT, fee);
+        hold.settled = true;
+        Ok(fee)
     }
 }
