+
+#[test]
+fn settle_with_fee_collects_the_fee() {
+    let mut l = accounts();
+    let mut s = Settlement::new();
+    let id = s.hold(&mut l, "alice", "bob", 100).unwrap();
+    let total_before = l.total();
+    let fee = s.settle_with_fee(&mut l, id, 333).unwrap();
+    assert_eq!(fee, 3);
+    assert_eq!(l.balance("bob"), 97);
+    assert_eq!(l.balance(FEES_ACCOUNT), 3);
+    assert_eq!(l.total(), total_before);
+}
+
+#[test]
+fn fee_is_exact() {
+    let mut l = accounts();
+    let mut s = Settlement::new();
+    let id = s.hold(&mut l, "alice", "bob", 100).unwrap();
+    let fee = s.settle_with_fee(&mut l, id, 333).unwrap();
+    assert_eq!(fee, 3);
+}
+
+#[test]
+fn settling_same_hold_twice_is_refused() {
+    let mut l = accounts();
+    let mut s = Settlement::new();
+    let id = s.hold(&mut l, "alice", "bob", 100).unwrap();
+    s.settle_with_fee(&mut l, id, 333).unwrap();
+    assert!(s.settle_with_fee(&mut l, id, 333).is_err());
+}
+
+#[test]
+fn settling_same_hold_twice_does_not_charge_fee_twice() {
+    let mut l = accounts();
+    let mut s = Settlement::new();
+    let id = s.hold(&mut l, "alice", "bob", 100).unwrap();
+    let _fee = s.settle_with_fee(&mut l, id, 333).unwrap();
+    let fees_before = l.balance(FEES_ACCOUNT);
+    assert!(s.settle_with_fee(&mut l, id, 333).is_err());
+    assert_eq!(l.balance(FEES_ACCOUNT), fees_before);
+    assert_eq!(l.total(), accounts().total());
+}
