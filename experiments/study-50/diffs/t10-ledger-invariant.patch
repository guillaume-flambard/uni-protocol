diff --git a/src/ledger.rs b/src/ledger.rs
index 03da51c..8ad95b4 100644
--- a/src/ledger.rs
+++ b/src/ledger.rs
@@ -16,10 +16,34 @@ impl Ledger {
 
 /// Move `amount` from account `from` to account `to`.
 ///
-/// BUG: credits the destination without debiting the source, which creates
-/// money out of nothing.
+/// The source is debited and the destination is credited, so the total is
+/// conserved. Refused with an `Err` (leaving the ledger untouched) when:
+/// either account is out of range, `amount` is negative, the source would be
+/// overdrawn, or the arithmetic would overflow.
 pub fn transfer(ledger: &mut Ledger, from: usize, to: usize, amount: i64) -> Result<(), String> {
-    let _ = from;
-    ledger.balances[to] += amount;
+    let n = ledger.balances.len();
+    if from >= n || to >= n {
+        return Err(format!("account out of range: from={from}, to={to}, accounts={n}"));
+    }
+    if amount < 0 {
+        return Err(format!("negative transfer amount: {amount}"));
+    }
+    if ledger.balances[from] < amount {
+        return Err(format!(
+            "insufficient funds in account {from}: {} < {amount}",
+            ledger.balances[from]
+        ));
+    }
+    if from == to {
+        return Ok(());
+    }
+    let debited = ledger.balances[from]
+        .checked_sub(amount)
+        .ok_or_else(|| "underflow debiting source".to_string())?;
+    let credited = ledger.balances[to]
+        .checked_add(amount)
+        .ok_or_else(|| "overflow crediting destination".to_string())?;
+    ledger.balances[from] = debited;
+    ledger.balances[to] = credited;
     Ok(())
 }
diff --git a/tests/it.rs b/tests/it.rs
index e192246..b11a4d3 100644
--- a/tests/it.rs
+++ b/tests/it.rs
@@ -8,3 +8,72 @@ fn transfer_moves_money() {
     assert_eq!(ledger.balance(0), 70);
     assert_eq!(ledger.balance(1), 30);
 }
+
+fn total(ledger: &Ledger) -> i64 {
+    (0..ledger.balances.len()).map(|i| ledger.balance(i)).sum()
+}
+
+#[test]
+fn overdraft_is_refused_without_moving_money() {
+    let mut ledger = Ledger::new(2);
+    ledger.balances[0] = 10;
+    ledger.balances[1] = 5;
+    let snapshot = ledger.balances.clone();
+    assert!(transfer(&mut ledger, 0, 1, 11).is_err());
+    assert_eq!(ledger.balances, snapshot);
+}
+
+#[test]
+fn exact_balance_transfer_is_allowed() {
+    let mut ledger = Ledger::new(2);
+    ledger.balances[0] = 42;
+    transfer(&mut ledger, 0, 1, 42).expect("spending the full balance should succeed");
+    assert_eq!(ledger.balance(0), 0);
+    assert_eq!(ledger.balance(1), 42);
+}
+
+#[test]
+fn out_of_range_accounts_are_refused_not_panicked() {
+    let mut ledger = Ledger::new(2);
+    ledger.balances[0] = 100;
+    let snapshot = ledger.balances.clone();
+    assert!(transfer(&mut ledger, 0, 2, 1).is_err());
+    assert!(transfer(&mut ledger, 2, 0, 1).is_err());
+    assert!(transfer(&mut ledger, 99, 98, 1).is_err());
+    assert_eq!(ledger.balances, snapshot);
+}
+
+#[test]
+fn negative_amount_is_refused_without_moving_money() {
+    let mut ledger = Ledger::new(2);
+    ledger.balances[0] = 100;
+    let snapshot = ledger.balances.clone();
+    assert!(transfer(&mut ledger, 0, 1, -50).is_err());
+    assert_eq!(ledger.balances, snapshot);
+}
+
+#[test]
+fn self_transfer_is_a_noop() {
+    let mut ledger = Ledger::new(1);
+    ledger.balances[0] = 70;
+    transfer(&mut ledger, 0, 0, 70).expect("self transfer within balance should succeed");
+    assert_eq!(ledger.balance(0), 70);
+    assert_eq!(total(&ledger), 70);
+}
+
+#[test]
+fn sequence_of_transfers_conserves_total() {
+    let mut ledger = Ledger::new(3);
+    ledger.balances[0] = 300;
+    ledger.balances[1] = 150;
+    let before = total(&ledger);
+    transfer(&mut ledger, 0, 1, 120).unwrap();
+    transfer(&mut ledger, 1, 2, 90).unwrap();
+    transfer(&mut ledger, 2, 0, 30).unwrap();
+    assert!(transfer(&mut ledger, 2, 1, 9_999).is_err());
+    transfer(&mut ledger, 0, 2, 5).unwrap();
+    assert_eq!(total(&ledger), before, "total must be conserved");
+    assert_eq!(ledger.balance(0), 205);
+    assert_eq!(ledger.balance(1), 180);
+    assert_eq!(ledger.balance(2), 65);
+}
