+#[test]
+fn fee_is_exact() {
+    let mut l = accounts();
+    let mut s = Settlement::new();
+    let hold_id = s.hold(&mut l, "alice", "bob", 100).unwrap();
+    let fee = s.settle_with_fee(&mut l, hold_id, 250).unwrap();
+    assert_eq!(fee, 2);
+    assert_eq!(l.balance("bob"), 100 - 2);
+    assert_eq!(l.balance(FEES_ACCOUNT), 2);
+}
