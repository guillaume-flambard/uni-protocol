diff --git a/src/settlement.rs b/src/settlement.rs
index 8781231..c146187 100644
--- a/src/settlement.rs
+++ b/src/settlement.rs
@@ -81,10 +81,23 @@ impl Settlement {
     /// Returns the fee that was collected.
     pub fn settle_with_fee(
         &mut self,
-        _ledger: &mut Ledger,
-        _id: u64,
-        _fee_bps: u64,
+        ledger: &mut Ledger,
+        id: u64,
+        fee_bps: u64,
     ) -> Result<i64, String> {
-        Err("settle_with_fee is not implemented".to_string())
+        let hold = self
+            .holds
+            .iter_mut()
+            .find(|h| h.id == id)
+            .ok_or_else(|| format!("unknown hold {id}"))?;
+        if hold.settled {
+            return Err(format!("hold {id} is already settled"));
+        }
+        hold.settled = true;
+        let fee = (hold.amount as u64 * fee_bps) / 10_000u64;
+        let fee_i64 = fee as i64;
+        ledger.debit(&hold.to, fee_i64);
+        ledger.credit(FEES_ACCOUNT, fee_i64);
+        Ok(fee_i64)
     }
 }
