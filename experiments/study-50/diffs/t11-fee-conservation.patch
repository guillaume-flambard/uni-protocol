+
+#[test]
+fn fee_is_exact() {
+    let mut l = accounts_with_fees();
+    let mut s = Settlement::new();
+    let hold_id = s.hold(&mut l, "alice", "bob", 100).unwrap();
+    let total = l.total();
+
+    assert_eq!(s.settle_with_fee(&mut l, hold_id, 333), Ok(3));
+    assert_eq!(l.balance("alice"), 0);
+    assert_eq!(l.balance("bob"), 97);
+    assert_eq!(l.balance(FEES_ACCOUNT), 3);
+    assert_eq!(l.total(), total);
+    assert!(s.holds.iter().find(|h| h.id == hold_id).unwrap().settled);
+}
+
+#[test]
+fn settling_same_hold_twice_does_not_charge_fee_twice() {
+    let mut l = accounts_with_fees();
+    let mut s = Settlement::new();
+    let hold_id = s.hold(&mut l, "alice", "bob", 100).unwrap();
+
+    assert_eq!(s.settle_with_fee(&mut l, hold_id, 333), Ok(3));
+    assert!(s.settle_with_fee(&mut l, hold_id, 333).is_err());
+    assert_eq!(l.balance("bob"), 97);
+    assert_eq!(l.balance(FEES_ACCOUNT), 3);
+}
