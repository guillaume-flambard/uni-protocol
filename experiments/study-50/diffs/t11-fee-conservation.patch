diff --git a/src/settlement.rs b/src/settlement.rs
index 880f793..6cc6cb9 100644
--- a/src/settlement.rs
+++ b/src/settlement.rs
@@ -79,10 +79,43 @@ impl Settlement {
     /// Returns the fee that was collected.
     pub fn settle_with_fee(
         &mut self,
-        _ledger: &mut Ledger,
-        _id: u64,
-        _fee_bps: u64,
+        ledger: &mut Ledger,
+        id: u64,
+        fee_bps: u64,
     ) -> Result<i64, String> {
-        Err("settle_with_fee is not implemented".to_string())
+        let hold = self
+            .holds
+            .iter_mut()
+            .find(|h| h.id == id)
+            .ok_or_else(|| format!("unknown hold {id}"))?;
+        if hold.settled {
+            return Err(format!("hold {id} is already settled"));
+        }
+        if !ledger.exists(FEES_ACCOUNT) {
+            return Err("unknown account".to_string());
+        }
+
+        let fee = i128::from(hold.amount)
+            .checked_mul(i128::from(fee_bps))
+            .ok_or_else(|| "fee calculation overflow".to_string())?
+            / 10_000;
+        if fee > i128::from(i64::MAX) {
+            return Err("fee calculation overflow".to_string());
+        }
+        let fee = fee as i64;
+        if fee > hold.amount {
+            return Err("fee exceeds held amount".to_string());
+        }
+        if ledger.balance(&hold.to) < fee {
+            return Err(format!("insufficient balance in '{}'", hold.to));
+        }
+        if ledger.balance(FEES_ACCOUNT) > i64::MAX - fee {
+            return Err("fee account balance overflow".to_string());
+        }
+
+        ledger.debit(&hold.to, fee);
+        ledger.credit(FEES_ACCOUNT, fee);
+        hold.settled = true;
+        Ok(fee)
     }
 }
