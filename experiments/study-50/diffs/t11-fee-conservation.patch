+
+#[test]
+fn settle_with_fee_takes_fee_into_fees_account() {
+    let mut l = accounts();
+    let mut s = Settlement::new();
+    let id = s.hold(&mut l, "alice", "bob", 100).unwrap();
+    assert_eq!(l.balance("bob"), 100);
+    assert_eq!(l.balance(FEES_ACCOUNT), 0);
+    let fee = s.settle_with_fee(&mut l, id, 250).unwrap();
+    assert_eq!(fee, 2);
+    assert_eq!(l.balance("bob"), 98);
+    assert_eq!(l.balance(FEES_ACCOUNT), 2);
+}
+
+#[test]
+fn fee_is_exact() {
+    let cases: &[(i64, u64, i64)] = &[
+        (100, 3333, 33),
+        (3, 3333, 0),
+        (1, 5000, 0),
+        (99, 50, 0),
+        (20000, 1, 2),
+        (7, 0, 0),
+    ];
+    for (amount, bps, expected) in cases {
+        let mut l = Ledger::new();
+        l.open("alice", amount * 2 + 10).unwrap();
+        l.open("bob", 0).unwrap();
+        l.open(FEES_ACCOUNT, 0).unwrap();
+        let mut s = Settlement::new();
+        let before = l.total();
+        let id = s.hold(&mut l, "alice", "bob", *amount).unwrap();
+        let charged = s.settle_with_fee(&mut l, id, *bps).unwrap();
+        assert_eq!(charged, *expected);
+        assert_eq!(l.balance(FEES_ACCOUNT), *expected);
+        assert_eq!(l.total(), before);
+    }
+}
+
+#[test]
+fn settling_a_hold_twice_is_refused() {
+    let mut l = accounts();
+    let mut s = Settlement::new();
+    let id = s.hold(&mut l, "alice", "bob", 100).unwrap();
+    _ = s.settle_with_fee(&mut l, id, 250).unwrap();
+    let before_fee = l.balance(FEES_ACCOUNT);
+    assert!(s.settle_with_fee(&mut l, id, 250).is_err());
+    assert_eq!(l.balance(FEES_ACCOUNT), before_fee);
+}
