diff --git a/src/api.rs b/src/api.rs
index 770113e..16aa2a7 100644
--- a/src/api.rs
+++ b/src/api.rs
@@ -4,3 +4,12 @@
 pub fn format_price(cents: u64) -> String {
     cents.to_string()
 }
+
+/// Format a price given in cents with a currency symbol and decimals.
+///
+/// The price is formatted with the given symbol, converted from cents to dollars
+/// with 2 decimal places.
+pub fn format_price_with_symbol(cents: u64, symbol: &str) -> String {
+    let dollars = cents as f64 / 100.0;
+    format!("{}{:.2}", symbol, dollars)
+}
