+
+#[test]
+fn settle_with_fee_basic() {
+    let mut l = accounts();
+    let mut s = Settlement::new();
+    let id = s.hold(&mut l, "alice", "bob", 100).unwrap();
+    let fee = s.settle_with_fee(&mut l, id, 100).unwrap();
+    assert_eq!(fee, 1);
+    assert_eq!(l.balance("bob"), 99);
+    assert_eq!(l.balance("fees"), 1);
+}
+
+#[test]
+fn settle_with_fee_exact_calculation() {
+    let mut l = accounts();
+    let mut s = Settlement::new();
+    let id = s.hold(&mut l, "alice", "bob", 100).unwrap();
+    let fee = s.settle_with_fee(&mut l, id, 333).unwrap();
+    assert_eq!(fee, 3);
+    assert_eq!(l.balance("bob"), 97);
+    assert_eq!(l.balance("fees"), 3);
+}
+
+#[test]
+fn settle_with_fee_zero_amount() {
+    let mut l = accounts();
+    l.open("alice2", 100).unwrap();
+    let mut s = Settlement::new();
+    let id = s.hold(&mut l, "alice2", "bob", 100).unwrap();
+    let fee = s.settle_with_fee(&mut l, id, 100).unwrap();
+    assert_eq!(fee, 1);
+    assert_eq!(l.balance("bob"), 99);
+    assert_eq!(l.balance("fees"), 1);
+}
+
+#[test]
+fn settle_with_fee_hundred_basis_points() {
+    let mut l = accounts();
+    l.open("alice2", 200).unwrap();
+    let mut s = Settlement::new();
+    let id = s.hold(&mut l, "alice2", "bob", 200).unwrap();
+    let fee = s.settle_with_fee(&mut l, id, 100).unwrap();
+    assert_eq!(fee, 2);
+    assert_eq!(l.balance("bob"), 198);
+    assert_eq!(l.balance("fees"), 2);
+}
+
+#[test]
+fn settle_with_fee_settle_twice_refused() {
+    let mut l = accounts();
+    let mut s = Settlement::new();
+    let id = s.hold(&mut l, "alice", "bob", 100).unwrap();
+    let _ = s.settle_with_fee(&mut l, id, 100).unwrap();
+    let result = s.settle_with_fee(&mut l, id, 100);
+    assert!(result.is_err());
+    assert!(result.unwrap_err().contains("already settled"));
+}
+
+#[test]
+fn settle_with_fee_is_exact() {
+    let mut l = accounts();
+    let mut s = Settlement::new();
+    let id = s.hold(&mut l, "alice", "bob", 100).unwrap();
+    let fee = s.settle_with_fee(&mut l, id, 333).unwrap();
+    assert_eq!(fee, 3);
+    assert_eq!(l.balance("bob"), 97);
+    assert_eq!(l.balance("fees"), 3);
+}
+
+#[test]
+fn settle_without_fee_compared_to_with_fee() {
+    let mut l1 = accounts();
+    let mut s1 = Settlement::new();
+    let id1 = s1.hold(&mut l1, "alice", "bob", 100).unwrap();
+    let _ = s1.settle(id1).unwrap();
+    
+    let mut l2 = accounts();
+    let mut s2 = Settlement::new();
+    let id2 = s2.hold(&mut l2, "alice", "bob", 100).unwrap();
+    let _ = s2.settle_with_fee(&mut l2, id2, 100).unwrap();
+    
+    assert_eq!(l1.balance("bob"), 100);
+    assert_eq!(l2.balance("bob"), 99);
+    assert_eq!(l1.balance("fees"), 0);
+    assert_eq!(l2.balance("fees"), 1);
+}
