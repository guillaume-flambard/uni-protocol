 }
+
+#[test]
+fn settle_with_fee() {
+    let mut l = accounts();
+    let mut s = Settlement::new();
+    let id = s.hold(&mut l, "alice", "bob", 100).unwrap();
+    let fee = s.settle_with_fee(&mut l, id, 500).unwrap();
+    assert_eq!(fee, 5);
+    assert_eq!(l.balance("bob"), 95);
+    assert_eq!(l.balance(FEES_ACCOUNT), 5);
+}
+
+#[test]
+fn fee_is_exact() {
+    let mut l = accounts();
+    let mut s = Settlement::new();
+    let id = s.hold(&mut l, "alice", "bob", 100).unwrap();
+    let fee = s.settle_with_fee(&mut l, id, 333).unwrap();
+    assert_eq!(fee, 3);
+    assert_eq!(l.balance("bob"), 97);
+}
+
+#[test]
+fn hold_cannot_be_settled_twice_with_fee() {
+    let mut l = accounts();
+    let mut s = Settlement::new();
+    let id = s.hold(&mut l, "alice", "bob", 100).unwrap();
+    let _ = s.settle_with_fee(&mut l, id, 100).unwrap();
+    assert!(s.settle_with_fee(&mut l, id, 100).is_err());
+    assert_eq!(l.balance("bob"), 99);
+}
+
+#[test]
+fn hold_cannot_be_settled_twice_without_fee() {
+    let mut l = accounts();
+    let mut s = Settlement::new();
+    let id = s.hold(&mut l, "alice", "bob", 100).unwrap();
+    let _ = s.settle(id).unwrap();
+    assert!(s.settle(id).is_err());
+}
