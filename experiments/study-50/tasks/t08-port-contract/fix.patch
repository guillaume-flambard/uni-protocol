 /// Parse a TCP port from a string.
 ///
-/// TODO: not implemented yet.
-pub fn parse_port(_s: &str) -> Result<u16, String> {
-    Err("not implemented".to_string())
+/// Returns an error for non-numeric input, out-of-range values, and port 0.
+/// No `unwrap()`/`expect()`: a bad input is a caller error, not a panic.
+pub fn parse_port(s: &str) -> Result<u16, String> {
+    let port: u16 = s
+        .trim()
+        .parse()
+        .map_err(|_| format!("invalid port: {s}"))?;
+    if port == 0 {
+        return Err("port 0 is not usable".to_string());
+    }
+    Ok(port)
 }
