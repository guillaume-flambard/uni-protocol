diff --git a/src/api.rs b/src/api.rs
index 770113e..cbb7e38 100644
--- a/src/api.rs
+++ b/src/api.rs
@@ -4,3 +4,8 @@
 pub fn format_price(cents: u64) -> String {
     cents.to_string()
 }
+
+/// Format a price given in cents with a currency symbol, e.g. "$1.50".
+pub fn format_price_with(cents: u64, symbol: &str) -> String {
+    format!("{symbol}{}.{:02}", cents / 100, cents % 100)
+}
